PRIV_DIR = $(MIX_APP_PATH)/priv
OBJECT_DIR = $(MIX_APP_PATH)/obj/pp_net_heatshrink
NIF = $(PRIV_DIR)/pp_net_heatshrink.dll
C_SRC = $(MAKEDIR)/c_src
SOURCES = "$(C_SRC)/pp_net_heatshrink.c" \
	"$(C_SRC)/heatshrink/heatshrink_encoder.c" \
	"$(C_SRC)/heatshrink/heatshrink_decoder.c"

CFLAGS = /nologo /O2 /W4 /MD /LD /I"$(ERTS_INCLUDE_DIR)" /I"$(C_SRC)/heatshrink"

all: $(NIF)

$(NIF): $(SOURCES)
	@ if not exist "$(PRIV_DIR)" mkdir "$(PRIV_DIR)"
	@ if not exist "$(OBJECT_DIR)" mkdir "$(OBJECT_DIR)"
	$(CC) $(CFLAGS) /Fo"$(OBJECT_DIR)/" /Fe$(NIF) $(SOURCES) /link /IMPLIB:"$(OBJECT_DIR)/pp_net_heatshrink.lib" /INCREMENTAL:NO

clean:
	@ if exist "$(OBJECT_DIR)" rmdir /s /q "$(OBJECT_DIR)"
	@ if exist "$(PRIV_DIR)/pp_net_heatshrink.dll" del /q "$(PRIV_DIR)/pp_net_heatshrink.dll"
	@ if exist "$(PRIV_DIR)/pp_net_heatshrink.lib" del /q "$(PRIV_DIR)/pp_net_heatshrink.lib"
	@ if exist "$(PRIV_DIR)/pp_net_heatshrink.exp" del /q "$(PRIV_DIR)/pp_net_heatshrink.exp"

.PHONY: all clean
